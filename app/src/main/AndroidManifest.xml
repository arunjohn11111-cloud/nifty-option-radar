<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to call the Upstox REST API and (from Phase 4 onward) the
         Market Data Feed V3 WebSocket. No other permissions are requested:
         this is a private, personal-use, read-only monitoring tool. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- TV support (Mi TV / Android TV / Google TV): both features are
         "not required" so this stays installable on a normal phone exactly
         as before. This only affects whether the app shows up as launchable
         on a TV home screen after sideloading — no phone-side behaviour
         changes. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_view"
        android:banner="@android:drawable/ic_menu_view"
        android:theme="@style/Theme.NiftyOptionRadar"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NiftyOptionRadar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>

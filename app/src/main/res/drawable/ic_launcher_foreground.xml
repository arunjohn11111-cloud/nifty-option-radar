<?xml version="1.0" encoding="utf-8"?>
<!-- App icon foreground: the classic iron / Mars symbol (a ring with a 45-degree arrow), an
     alchemical mark that predates any modern brand by centuries and belongs to no one. Drawn
     from scratch to our own proportions — deliberately NOT a reproduction of any car maker's
     logo: there is no wordmark and no diagonal grille bar.

     It also happens to say exactly the right thing for this app: an arrow pointing up.

     Laid out on the 108x108 adaptive-icon canvas, with every stroke kept inside the central
     72x72 safe zone (x and y between 18 and 90) so no launcher shape can crop it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring: centre (54,62), radius 20, drawn as two half-arcs. -->
    <path
        android:pathData="M34,62 A20,20 0 1,1 74,62 A20,20 0 1,1 34,62"
        android:strokeColor="#D8DDE3"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Centre blip: the one thing that tells the Radar mark apart from Quick Trade's. -->
    <path
        android:pathData="M54,57 a5,5 0 1,1 0,10 a5,5 0 1,1 0,-10"
        android:fillColor="#9AA3AC" />

    <!-- Arrow shaft: leaves the ring at 45 degrees, up and to the right. -->
    <path
        android:pathData="M68,48 L84,32"
        android:strokeColor="#D8DDE3"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Arrowhead: an open corner, the way the symbol is traditionally drawn. -->
    <path
        android:pathData="M71,32 L84,32 L84,45"
        android:strokeColor="#D8DDE3"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV home-screen banner (320x180). Reuses the same iron mark as the launcher icon,
     scaled up inside a group so the coordinates stay identical to ic_launcher_foreground.xml
     and the two can never drift apart. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <path
        android:pathData="M0,0 h320 v180 h-320 z"
        android:fillColor="#14181D" />

    <group
        android:translateX="90"
        android:translateY="20"
        android:pivotX="0"
        android:pivotY="0"
        android:scaleX="1.3"
        android:scaleY="1.3">

        <path
            android:pathData="M34,62 A20,20 0 1,1 74,62 A20,20 0 1,1 34,62"
            android:strokeColor="#D8DDE3"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <path
            android:pathData="M54,57 a5,5 0 1,1 0,10 a5,5 0 1,1 0,-10"
            android:fillColor="#9AA3AC" />

        <path
            android:pathData="M68,48 L84,32"
            android:strokeColor="#D8DDE3"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <path
            android:pathData="M71,32 L84,32 L84,45"
            android:strokeColor="#D8DDE3"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />

    </group>

</vector>
